# ---------------------------------------------------------------------------
# ScaleChefs homepage — environment variables
#
# Copy this file to `.env` (or set the variables in the Hostinger panel).
# `.env` is git-ignored, so secrets stay out of GitHub.
#
# On Hostinger:  hPanel → Node.js app → Environment variables / Main
# (or upload a `.env` file next to package.json — Next.js reads it at runtime)
# ---------------------------------------------------------------------------

# --- Email delivery (contact form) -----------------------------------------
# Without a key the site still renders, but POST /api/contact answers 503.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered (defaults to growth.scalechefs@gmail.com)
CONTACT_TO_EMAIL=growth.scalechefs@gmail.com

# The verified "from" address Resend may send on behalf of.
# Resend's sandbox sender only delivers to the account owner's own inbox,
# so set this to a domain you have verified in Resend before going live.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Site metadata ----------------------------------------------------------
# Absolute public URL of the website. Used to build absolute Open Graph and
# Twitter card image URLs. The code already defaults to https://scalechefs.com,
# so this only needs setting if the domain ever changes.
NEXT_PUBLIC_SITE_URL=https://scalechefs.com

# --- Optional ----------------------------------------------------------------
# Only needed when the app is served from a subdirectory
# (e.g. https://example.com/scalechefs/). Trailing slash, no leading slash.
# Leave unset for a normal root-domain deployment.
NEXT_PUBLIC_BASE_PATH=
