# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev logs - DO NOT PUSH (local memory only)
dev.log
dev2.log
dev-3002.log
dev-current.log
dev*.log
.wrangler/wrangler.log

# local opencode agent skills - installed per-machine, DO NOT PUSH
/.opencode/

/dist/
/.wrangler/
/outputs/
/work/

# brand guideline source documents (reference only, never commit)
ScaleChefs-BrandGuidelines.pdf

# source logo exports supplied locally (never commit)
/sc-lpgp-png.png
/scalechefs logo*.jpg
